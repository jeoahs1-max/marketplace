rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVendor() {
      return request.auth != null && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'vendeur';
    }
    match /conversations/{doc} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
    }
    match /products/{doc} {
      allow read: if true;
      allow create: if isVendor() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isVendor() && resource.data.ownerId == request.auth.uid;
    }
    match /avis/{doc} {
      allow read: if true;
      allow create: if request.auth != null;
    }
    match /profiles/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if true;
      allow update: if request.auth != null && request.auth.uid == userId;
    }
    match /artifacts/{appId}/public/data/users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
    }
    match /artifacts/{appId}/public/data/products/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'jeoahs1@gmail.com';
    }
    match /artifacts/{appId}/public/data/affiliate_products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.affiliateId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.affiliateId == request.auth.uid;
    }
    match /artifacts/{appId}/public/data/affiliate_promos/{productId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'jeoahs1@gmail.com';
    }
    match /artifacts/{appId}/public/data/withdrawals/{withdrawalId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || request.auth.token.email == 'jeoahs1@gmail.com');
      allow update: if request.auth != null && request.auth.token.email == 'jeoahs1@gmail.com' && resource.data.status == 'pending' && request.resource.data.status == 'approved_pending_payout';
    }
  }
}